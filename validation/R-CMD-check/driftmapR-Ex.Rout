> pkgname <- "driftmapR"
> source(file.path(R.home("share"), "R", "examples-header.R"))
> options(warn = 1)
> library('driftmapR')
> 
> base::assign(".oldSearch", base::search(), pos = 'CheckExEnv')
> base::assign(".old_wd", base::getwd(), pos = 'CheckExEnv')
> cleanEx()
> nameEx("align_snapshots")
> ### * align_snapshots
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: align_snapshots
> ### Title: Align coordinate snapshots by orthogonal Procrustes fitting
> ### Aliases: align_snapshots
> 
> ### ** Examples
> 
> p <- data.frame(entity = letters[1:4], time = 1, x = c(0, 2, 0, 1),
+                 y = c(0, 0, 2, 1))
> q <- transform(p, time = 2, x = -y + 5, y = x - 3)
> fit <- drift_data(rbind(p, q)) |> align_snapshots()
> fit$transformations[c("time", "reference_time", "n_matched", "rss")]
  time reference_time n_matched         rss
1    1              1         0 0.00000e+00
2    2              1         4 1.26341e-31
> measure_drift(fit)
  entity time_from time_to x_from y_from         x_to          y_to
