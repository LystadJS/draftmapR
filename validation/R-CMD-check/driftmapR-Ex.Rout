> ### Name: match_clusters
> ### Title: Match cluster identities across adjacent snapshots
> ### Aliases: match_clusters
> 
> ### ** Examples
> 
> first <- data.frame(entity = letters[1:6], time = 1,
+                     x = c(0, 1, 0, 4, 5, 4), y = c(0, 0, 1, 0, 0, 1),
+                     cluster = rep(c("A", "B"), each = 3))
> second <- first
> second$time <- 2
> second$cluster <- rep(c("renamed_2", "renamed_1"), each = 3)
> fit <- drift_data(rbind(first, second)) |> match_clusters()
> fit$clusters
   entity time period_index cluster_original cluster_id cluster_status
1       a    1            1                A      C0001        initial
2       b    1            1                A      C0001        initial
3       c    1            1                A      C0001        initial
4       d    1            1                B      C0002        initial
5       e    1            1                B      C0002        initial
6       f    1            1                B      C0002        initial
7       a    2            2        renamed_2      C0001        matched
8       b    2            2        renamed_2      C0001        matched
9       c    2            2        renamed_2      C0001        matched
10      d    2            2        renamed_1      C0002        matched
11      e    2            2        renamed_1      C0002        matched
12      f    2            2        renamed_1      C0002        matched
